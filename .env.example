# Local development only. Configure these values in Vercel Project Settings
# -> Environment Variables for production. Do not commit a real .env file.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COINGECKO_API_KEY=
TWELVEDATA_API_KEY=replace-with-your-twelve-data-api-key
PRICE_CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=5

# Optional: only needed if you intentionally want the app to create the
# built-in demo admin when the admin record is missing from tradeverse.db.
TRADEVERSE_BOOTSTRAP_ADMIN=0
