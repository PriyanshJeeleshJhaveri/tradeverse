# Copy this file to .env for local development. NEVER commit the real .env.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

FLASK_SECRET_KEY=change-me-to-a-long-random-string

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tradeverse

# First administrator account (created once if it does not exist yet)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=change-me-too

# Price data
TWELVEDATA_API_KEY=
COINGECKO_API_KEY=

# Optional tuning (defaults shown)
PRICE_CACHE_TTL_SECONDS=600
TRADE_PRICE_MAX_AGE_SECONDS=60
REQUEST_TIMEOUT_SECONDS=6
